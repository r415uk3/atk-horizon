<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge with transparent bars; the window colour matches the Compose background, and
         values-night switches it with the app's night mode (AtkApp sets it from the theme setting). -->
    <style name="Theme.AtkHorizon" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
